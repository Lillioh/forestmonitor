# Requires Node.js 24.15+ (24.x LTS) and a writable local filesystem.
FOREST_DEPLOYMENT=local
FOREST_DATABASE_PATH=./data/forest-monitor.sqlite

# Set true when the dashboard is served over HTTPS. Keep false for local HTTP.
FOREST_COOKIE_SECURE=false

# Off by default. Enables administrator-created, clearly labeled test detections.
FOREST_SIMULATION_ENABLED=false

# Bundled Cagayan de Oro region; use an absolute path for a different local map.
FOREST_MAP_ARCHIVE=./public/maps/mapawa_malasag.pmtiles

# Optional one-way mirror. Leave both empty for fully local operation.
FOREST_SYNC_URL=
FOREST_SYNC_TOKEN=

# Set by receiver/provision.py when enabling ESP32 Wi-Fi ingestion.
# Keep this server-side; ESP32 nodes receive separate per-node credentials.
FOREST_INGEST_TOKEN=
