{
  "name": "forest-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node tests/http-smoke.mjs",
    "test:routes": "node tests/route-integration.mjs",
    "account:create": "node --env-file-if-exists=.env.local scripts/account.mjs",
    "account:reset": "node --env-file-if-exists=.env.local scripts/account.mjs --reset",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "map:prepare": "node --env-file-if-exists=.env.local scripts/prepare-map.mjs",
    "map:assets": "node scripts/prepare-map-assets.mjs",
    "sync:run": "node --env-file-if-exists=.env.local scripts/sync.mjs",
    "sync:once": "node --env-file-if-exists=.env.local scripts/sync.mjs --once",
    "sync:status": "node --env-file-if-exists=.env.local scripts/sync-status.mjs",
    "cloud:setup": "node --env-file-if-exists=.env.local scripts/cloud-setup.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "6.15.0",
    "mongodb": "7.7.0",
    "next": "16.3.2",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
