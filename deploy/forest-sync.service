[Unit]
Description=Forest Monitor optional cloud upload worker
After=network.target

[Service]
Type=simple
User=forest
WorkingDirectory=/opt/forest-monitor
Environment=NODE_ENV=production
Environment=FOREST_DEPLOYMENT=local
ExecStart=/usr/bin/npm run sync:run
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
