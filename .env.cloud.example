# Vercel / cloud only. Never use this environment on the local Pi.
FOREST_DEPLOYMENT=cloud
FOREST_COOKIE_SECURE=true
FOREST_SIMULATION_ENABLED=false
# Copy the Atlas Drivers URI here in a private .env.cloud.local file.
# Replace placeholders and percent-encode reserved characters in credentials.
MONGODB_URI=
MONGODB_DATABASE=forest_monitor
FOREST_CLOUD_DEVICE_ID=
# The bundled archive is included in Next's server function trace.
FOREST_MAP_ARCHIVE=./public/maps/outpost.pmtiles
